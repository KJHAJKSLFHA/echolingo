# ============================ 构建产物 ============================
# 打包结果，随时可以用 desktop/build.mjs 重新生成
dist/
release/

# ============================ 依赖与缓存 ============================
# 都可以重新下载/生成，而且体积大。
# ⚠️ desktop/.electron-cache 里那个 zip 有 124MB，**超过 GitHub 单文件 100MB 上限**，
#    一旦提交上去，push 会被直接拒绝，还得 rewrite 历史才能清掉。务必排除。
node_modules/
.pnpm-store/
.electron-cache/
desktop/.electron-cache/
desktop/.stage/

# ============================ 本地测试残留 ============================
# 桌面版测试时用的浏览器 profile（收藏夹、Service Worker 缓存等）
.udd*/
.udd
shots/tmp-*

# 测试音频：由 media/demo.m4a 重复拼接生成，几秒钟就能重建
bench/long.wav

# ============================ 系统 ============================
.DS_Store
Thumbs.db

# 本地工具（gh 等），不提交
desktop/.tools/

# GitHub Pages：不要排除 .nojekyll（它本身就是给 Pages 用的标记文件）
!.nojekyll

# Netlify 部署用的暂存目录（268MB，由 desktop/.tools/deploy.sh 拼装）
.deploy/

# Local Netlify folder
.netlify

# 测试用的合成音频（由 macOS say 生成，可随时重建）
bench/*-test.wav

# 三语首页截图（由 bench/shot-site.mjs 随时重生成，4MB，不入库）
shots/site-i18n/

# Windows 打包用的 .ico 图标（由 desktop/build/make-icon.mjs 从 SVG 生成，可随时重建）
desktop/build/

# electron-builder 生成的锁文件（本仓库用 npm ci 时才有意义，
# 而本机没有系统 npm，锁文件只会造成「版本解析不一致」的困惑）
package-lock.json

# 我本地做视觉/数值验证时产生的截图，不是页面素材，不进仓库也不上线
.verify-shots/

# 回归测试生成的截图（本地看，不进仓库）
bench/shots/
